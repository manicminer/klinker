[Desktop Entry]
Type=Application
Version=1.5
Name=Klinker
GenericName=Browser Chooser
Comment=Choose which browser opens a link, or route links by rules
Exec=klinker %U
TryExec=klinker
Icon=io.github.manicminer.Klinker
Terminal=false
StartupNotify=false
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
Categories=Network;WebBrowser;
Keywords=browser;link;url;chooser;picker;router;
Actions=Configure;

[Desktop Action Configure]
Name=Configure Klinker
Exec=klinker --settings
